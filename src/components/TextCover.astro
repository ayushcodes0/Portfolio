---
// Typographic cover for projects without a screenshot (e.g. internal work that can't be shown).
interface Props {
  title: string;
  subtitle: string;
  // "card": peeks up from the bottom of a project card; "full": fills a framed cover.
  variant?: 'card' | 'full';
}

const { title, subtitle, variant = 'card' } = Astro.props;
---

<div class:list={['text-cover', `is-${variant}`]} role="img" aria-label={`${title}: ${subtitle}`}>
  <div class="text-cover-bar" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="text-cover-body" aria-hidden="true">
    <p class="text-cover-title">{title}</p>
    <p class="text-cover-subtitle">{subtitle}</p>
  </div>
</div>

<style>
  .text-cover {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #f2f2f24d;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    background:
      radial-gradient(ellipse 60% 70% at 50% 100%, #f2f2f20f, #f2f2f200),
      #141414;
    overflow: hidden;
  }

  .text-cover.is-full {
    border: 0;
    border-radius: 0;
  }

  .text-cover-bar {
    display: flex;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid #f2f2f214;
  }

  .text-cover-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f2f2f22e;
  }

  .text-cover-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    text-align: center;
  }

  .text-cover-title {
    font-size: clamp(36px, 7vw, 88px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -2px;
    text-shadow: 0 5px 10px #0057ff26, 0 -5px 10px #ff5a001a, 0 -5px 25px #ffffff4d;
  }

  .text-cover-subtitle {
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(16px, 2vw, 26px);
  }
</style>
